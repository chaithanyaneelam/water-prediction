# Copy to .env and adjust if needed. Everything works with these defaults.
# SQLite (default):
DATABASE_URL=sqlite:///waternet.db
# MySQL example (uncomment and adjust):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/waternet
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-in-production
