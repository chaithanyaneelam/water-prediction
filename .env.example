[TEMPLATE]
[TEMPLATE]
# Copy to .env and adjust if needed. Everything works with these defaults.
# SQLite (default):
DATABASE_URL=sqlite:///waternet.db
# MySQL example (uncomment and adjust):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/waternet
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-in-production

# ---- Prediction notifications (optional) ----
# Email: Brevo (Sendinblue) transactional API - https://app.brevo.com
#   BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
#   If the account uses IP whitelisting, add your IP under
#   Security > Authorised IPs or sends return 401.
# SMS: TextBelt - https://textbelt.com (paid key; key=textbelt = 1 free/day).
# Leave empty -> messages go to the in-app outbox; requests never fail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WATERNET
SMS_API_KEY=
