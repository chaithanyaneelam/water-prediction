[TEMPLATE]
# Copy to .env and adjust if needed. Everything works with these defaults.
# SQLite (default):
DATABASE_URL=sqlite:///waternet.db
# MySQL example (uncomment and adjust):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/waternet
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-in-production

# ---- Prediction notifications (optional) ----
# Email: any SMTP account (Gmail: use an App Password, host smtp.gmail.com, port 587).
# SMS: Twilio-compatible gateway. Leave empty -> messages go to the in-app outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
